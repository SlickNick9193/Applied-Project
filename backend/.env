PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://postgres:password@postgres:5432/system_health_hub
REDIS_URL=redis://redis:6379

# Generate strong random values, e.g. `openssl rand -hex 32`
JWT_SECRET=12690f085cb9e541048e97e9e09e28baaa4fb476323d1f2e61e50f2fec744eec
SESSION_SECRET=e181a87c72280be62a1c94ea6476b2c24f8da2668a82a63a7b61898c7e85c47a
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Local fallback login — required (no defaults in code)
APP_USERNAME=admin
APP_PASSWORD=admin

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# GitHub OAuth — https://github.com/settings/applications/new
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# Microsoft OAuth — https://portal.azure.com → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:5000/auth/microsoft/callback
