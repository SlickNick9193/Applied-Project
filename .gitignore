logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime / uploads
backend/uploads/
*.pid
*.seed
*.pid.lock

# Operational data — never commit (real meter exports, sample CSVs)
data/
*.csv

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Coverage
coverage/
.nyc_output/

